{
	"functions": {
		"source": "functions"
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"hosting": {
		"site": "colorfulfutures",
		"public": "build",
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		]
	},
	"emulators": {
		"functions": {
			"port": 5001
		},
		"auth": {
			"port": 9099
		},
		"ui": {
			"enabled": true,
			"port": 4000
		}
	}
}
